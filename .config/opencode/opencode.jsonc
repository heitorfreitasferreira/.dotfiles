{
    "$schema": "https://opencode.ai/config.json",
    "update": "auto",
    "mcp": {
        "servers": {
            "codegraphcontext": {
                "type": "local",
                "command": [
                    "cgc",
                    "--database",
                    "neo4j",
                    "mcp",
                    "start"
                ],
                "timeout": {
                    "catalog": 15000,
                    "execution": 15000
                },
                "environment": {
                    "NEO4J_URI": "{env:NEO4J_URI}",
                    "NEO4J_USERNAME": "{env:NEO4J_USERNAME}",
                    "NEO4J_PASSWORD": "{env:NEO4J_PASSWORD}"
                }
            },
            "github": {
                "type": "remote",
                "url": "https://api.githubcopilot.com/mcp/",
                "disabled": true
            }
        }
    },
    "instructions": [
        "instructions/tiger-style.md",
        "instructions/writing.md"
    ],
    "plugins": [
        "@slkiser/opencode-quota"
    ],
    "permissions": [
        {
            "action": "skill",
            "resource": "*",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "council",
            "effect": "allow"
        },
        {
            "action": "skill",
            "resource": "santa",
            "effect": "allow"
        },
        {
            "action": "skill",
            "resource": "shell",
            "effect": "allow"
        },
        {
            "action": "skill",
            "resource": "tdd",
            "effect": "allow"
        },
        {
            "action": "skill",
            "resource": "writing",
            "effect": "allow"
        }
    ]
}
