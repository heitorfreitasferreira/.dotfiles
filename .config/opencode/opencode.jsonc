{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraphcontext": {
      "type": "local",
      "command": [
        "cgc",
        "mcp",
        "start"
      ],
      "enabled": true,
      "timeout": 15000
    },
    "aws-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "enabled": true,
      "env": {
        "AWS_PROFILE": "default",
        "AWS_REGION": "us-east-1",
        "AWS_DEFAULT_REGION": "us-east-1"
      }
    }
  },
  "agent": {
    "django-pattern-router": {
      "description": "Route Django requests to the right domain and suggest idiomatic patterns.",
      "mode": "subagent",
      "tools": {
        "bash": false,
        "write": false,
        "edit": false
      },
      "prompt": "{file:./prompts/django-pattern-router.prompt.md}"
    },
    "sherlock": {
      "description": "Investigate errors deeply and produce a root-cause debugging report.",
      "mode": "subagent",
      "tools": {
        "write": false,
        "edit": false,
        "task": false,
        "todowrite": false,
        "todoread": false
      },
      "prompt": "{file:./prompts/sherlock.prompt.md}"
    }
  },
  "permission": {}
}
