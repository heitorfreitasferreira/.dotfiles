{
    "$schema": "https://opencode.ai/config.json",
    "model": "opencode-go/deepseek-v4-flash",
    "mcp": {
        "codegraphcontext": {
            "type": "local",
            "command": [
                "cgc",
                "--database",
                "neo4j",
                "mcp",
                "start"
            ],
            "enabled": true,
            "timeout": 15000,
            "environment": {
                "NEO4J_URI": "bolt://192.168.40.27:7687",
                "NEO4J_USERNAME": "neo4j",
                "NEO4J_PASSWORD": "opencode123"
            }
        },
        "github": {
            "type": "remote",
            "url": "https://api.githubcopilot.com/mcp/",
            "enabled": true,
            "oauth": false,
            "headers": {
                "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
            }
        }
    },
    "permission": {
        "skill": {
            "council": "allow",
            "santa": "allow",
            "shell": "allow",
            "tdd": "allow",
            "*": "deny"
        }
    },
    "instructions": [
        "instructions/tiger-style.md"
    ],
    "plugin": [
        "@slkiser/opencode-quota",
        "/home/heitor/.agents/ponytail/.opencode/plugins/ponytail.mjs"
    ]
}
